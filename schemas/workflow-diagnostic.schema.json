{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:workflow-diagnostic:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "harness-local",
        "operator",
        "provider",
        "target",
        "cleanup"
      ]
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "field_path": {
      "type": "string",
      "maxLength": 256
    },
    "identifier": {
      "type": "string",
      "maxLength": 128
    },
    "correction": {
      "type": "string",
      "maxLength": 4096
    },
    "omissions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "message",
              "field_path",
              "identifier",
              "correction",
              "tool_call_id",
              "facts"
            ]
          },
          "reason": {
            "enum": [
              "sensitive",
              "oversized",
              "unavailable",
              "invalid"
            ]
          }
        },
        "required": [
          "field",
          "reason"
        ]
      }
    },
    "execution_occurred": {
      "enum": [
        "no",
        "yes",
        "unknown"
      ]
    },
    "resubmission_safe": {
      "type": "boolean"
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "keyword"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^urn:operator:schema:[a-z0-9-]+:v[0-9a-z]+$"
        },
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "keyword": {
          "enum": [
            "required",
            "type",
            "additionalProperties",
            "unevaluatedProperties",
            "enum",
            "const",
            "minLength",
            "maxLength",
            "pattern",
            "minimum",
            "maximum",
            "exclusiveMinimum",
            "exclusiveMaximum",
            "multipleOf",
            "minItems",
            "maxItems",
            "uniqueItems",
            "minProperties",
            "maxProperties",
            "oneOf",
            "anyOf",
            "not",
            "propertyNames"
          ]
        }
      }
    },
    "unsupported_fields": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounded untrusted field names, never values. Field purposes and required flags are reconstructed from the installed constraint.",
      "properties": {
        "names": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[ -~]*$"
          }
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omission_reasons": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "name_size_limit",
              "sensitive_name",
              "unsafe_name",
              "name_count_limit"
            ]
          }
        },
        "location_omitted": {
          "type": "boolean"
        }
      },
      "required": [
        "names",
        "omitted",
        "omission_reasons"
      ]
    },
    "facts": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 256
          },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "boolean"
          }
        ]
      },
      "description": "Producer-selected failure facts, never submitted bodies, credentials or secret locators. Strings are data, not instructions."
    }
  },
  "required": [
    "source",
    "stage",
    "reason",
    "message",
    "execution_occurred",
    "resubmission_safe"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "unsupported_fields"
        ]
      },
      "then": {
        "required": [
          "constraint"
        ],
        "properties": {
          "constraint": {
            "properties": {
              "keyword": {
                "const": "additionalProperties"
              }
            }
          }
        }
      }
    }
  ]
}
