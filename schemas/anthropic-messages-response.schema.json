{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:anthropic-messages-response:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "type": {
      "const": "message"
    },
    "role": {
      "const": "assistant"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/text"
          },
          {
            "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/thinking_block"
          },
          {
            "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/redacted_thinking"
          },
          {
            "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/tool_use"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "stop_reason": {
      "enum": [
        "end_turn",
        "tool_use",
        "max_tokens",
        "refusal",
        "pause_turn",
        "model_context_window_exceeded"
      ]
    },
    "stop_sequence": {
      "type": "null"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "container": {
      "type": "null"
    },
    "stop_details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "refusal"
            },
            "category": {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            "explanation": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1048576
            }
          },
          "required": [
            "type",
            "explanation"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cache_miss_reason": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 128
                    },
                    "cache_missed_input_tokens": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type",
                    "cache_missed_input_tokens"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": []
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "type",
    "role",
    "model",
    "content",
    "stop_reason",
    "stop_sequence"
  ]
}
