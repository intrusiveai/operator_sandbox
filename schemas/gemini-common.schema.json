{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:gemini-common:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        },
        "thought": {
          "type": "boolean"
        },
        "thoughtSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "text"
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functionCall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$",
              "not": {
                "pattern": "[\\r\\n]"
              }
            },
            "args": {
              "type": "object"
            },
            "id": {
              "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
            }
          },
          "required": [
            "name"
          ]
        },
        "thought": {
          "type": "boolean"
        },
        "thoughtSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "functionCall"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thought": {
          "type": "boolean"
        },
        "thoughtSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "thoughtSignature"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functionResponse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$",
              "not": {
                "pattern": "[\\r\\n]"
              }
            },
            "id": {
              "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "output": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 1048576
                }
              },
              "required": [
                "output"
              ]
            }
          },
          "required": [
            "name",
            "response"
          ]
        }
      },
      "required": [
        "functionResponse"
      ]
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "model"
        },
        "parts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/text"
              },
              {
                "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/call"
              },
              {
                "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/signature"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 1024
        }
      },
      "required": [
        "role",
        "parts"
      ]
    },
    "message": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "model"
            },
            "parts": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/text"
                  },
                  {
                    "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/call"
                  },
                  {
                    "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/signature"
                  }
                ]
              },
              "minItems": 0,
              "maxItems": 1024
            }
          },
          "required": [
            "role",
            "parts"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "user"
            },
            "parts": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 1048576
                      }
                    },
                    "required": [
                      "text"
                    ]
                  },
                  {
                    "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/result"
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 1024
            }
          },
          "required": [
            "role",
            "parts"
          ]
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promptTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidatesTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "thoughtsTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cachedContentTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolUsePromptTokenCount": {
          "const": 0
        },
        "promptTokensDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modality": {
                "const": "TEXT"
              },
              "tokenCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "modality",
              "tokenCount"
            ]
          },
          "minItems": 0,
          "maxItems": 1
        },
        "cacheTokensDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modality": {
                "const": "TEXT"
              },
              "tokenCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "modality",
              "tokenCount"
            ]
          },
          "minItems": 0,
          "maxItems": 1
        },
        "candidatesTokensDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modality": {
                "const": "TEXT"
              },
              "tokenCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "modality",
              "tokenCount"
            ]
          },
          "minItems": 0,
          "maxItems": 1
        },
        "toolUsePromptTokensDetails": {
          "type": "array",
          "maxItems": 0
        },
        "serviceTier": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "trafficType": {
          "enum": [
            "TRAFFIC_TYPE_UNSPECIFIED",
            "ON_DEMAND",
            "PROVISIONED_THROUGHPUT",
            "ON_DEMAND_PRIORITY",
            "ON_DEMAND_FLEX"
          ]
        }
      },
      "required": [
        "promptTokenCount",
        "totalTokenCount"
      ]
    },
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeThoughts": {
          "type": "boolean"
        },
        "thinkingBudget": {
          "type": "integer",
          "minimum": -1,
          "maximum": 9007199254740991
        },
        "thinkingLevel": {
          "enum": [
            "MINIMAL",
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      },
      "required": [],
      "not": {
        "required": [
          "thinkingBudget",
          "thinkingLevel"
        ]
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "thinking_config": {
          "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/thinking"
        },
        "response_models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x20\\x7f]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "tools_digest": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/digest"
        }
      },
      "required": [
        "max_output_tokens",
        "thinking_config",
        "response_models",
        "tools_digest"
      ]
    }
  }
}
