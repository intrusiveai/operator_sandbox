{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:bedrock-converse-response:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "$ref": "urn:operator:schema:bedrock-converse-common:v1alpha1#/$defs/assistant"
        }
      },
      "required": [
        "message"
      ]
    },
    "stopReason": {
      "enum": [
        "end_turn",
        "tool_use",
        "max_tokens",
        "stop_sequence",
        "guardrail_intervened",
        "content_filtered",
        "malformed_model_output",
        "malformed_tool_use",
        "model_context_window_exceeded"
      ]
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:bedrock-converse-common:v1alpha1#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "latencyMs"
      ]
    },
    "performanceConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency": {
          "enum": [
            "standard",
            "optimized"
          ]
        }
      },
      "required": [
        "latency"
      ]
    },
    "serviceTier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        }
      },
      "required": [
        "type"
      ]
    },
    "additionalModelResponseFields": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "output",
    "stopReason"
  ]
}
