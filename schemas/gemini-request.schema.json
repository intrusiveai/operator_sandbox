{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:gemini-request:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "systemInstruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 0,
                "maxLength": 131072
              }
            },
            "required": [
              "text"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "parts"
      ]
    },
    "contents": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/message"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "generationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "candidateCount": {
          "const": 1
        },
        "thinkingConfig": {
          "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/thinking"
        }
      },
      "required": [
        "maxOutputTokens",
        "candidateCount",
        "thinkingConfig"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "functionDeclarations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 8192
                },
                "parametersJsonSchema": {
                  "type": "object"
                }
              },
              "required": [
                "name",
                "parametersJsonSchema"
              ]
            },
            "minItems": 1,
            "maxItems": 128
          }
        },
        "required": [
          "functionDeclarations"
        ]
      },
      "minItems": 0,
      "maxItems": 1
    },
    "toolConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functionCallingConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "AUTO",
                "ANY",
                "NONE"
              ]
            }
          },
          "required": [
            "mode"
          ]
        }
      },
      "required": [
        "functionCallingConfig"
      ]
    }
  },
  "required": [
    "systemInstruction",
    "contents",
    "generationConfig",
    "tools",
    "toolConfig"
  ]
}
