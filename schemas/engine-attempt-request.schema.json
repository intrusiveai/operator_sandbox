{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:engine-attempt-request:v1alpha4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "input": {
      "$ref": "urn:operator:schema:execution-input:v1alpha1"
    },
    "scenario_id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id",
      "description": "Required only for scenario origin; must name a scenario in the submitted bundle. Forbidden for exploratory origin."
    },
    "parent_attempt_receipt_id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "caller_principal_id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "pre_actions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "description": "Explicit ordered setup; empty for targets without setup support. Action IDs must also be unique independently of object equality.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_type",
          "parameters"
        ],
        "properties": {
          "action_id": {
            "$ref": "#/$defs/id"
          },
          "action_type": {
            "const": "interceptor.injection/v1alpha1"
          },
          "parameters": {
            "$ref": "#/$defs/injection"
          }
        }
      }
    },
    "observation_selection": {
      "$ref": "urn:operator:schema:observation-selection:v1alpha1",
      "description": "Omission means all-permitted; profile and host policy still limit feedback."
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Guest assertion, never used to select or translate an operation."
    },
    "strategy_provenance_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "technique_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "injection_input": {
      "$ref": "urn:operator:schema:execution-input:v1alpha1"
    },
    "retain_injections": {
      "type": "boolean",
      "description": "Default false. Only valid with nonempty pre_actions; true retains injections for explicit deletion or lifecycle cleanup."
    },
    "origin": {
      "type": "string",
      "enum": [
        "scenario",
        "exploratory"
      ],
      "description": "Required explicit intent. Scenario requires a submitted scenario_id; exploratory forbids scenario_id. Never infer origin."
    }
  },
  "required": [
    "origin",
    "operation_id",
    "input"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "canonicalization"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "canonicalization": {
          "enum": [
            "raw",
            "jcs-v1"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "canonicalization": {
                "const": "jcs-v1"
              }
            },
            "required": [
              "canonicalization"
            ]
          },
          "then": {
            "properties": {
              "media_type": {
                "const": "application/json"
              }
            }
          }
        }
      ]
    },
    "pointer": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:/(?:[^~/\\x00-\\x1f\\x7f]|~[01])*)*$",
      "description": "RFC 6901 JSON Pointer; empty string selects the whole value.",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "ordinal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^(first|every|[1-9][0-9]{0,9})$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/[^?#\\\\\\x00-\\x1f\\x7f]*$",
      "description": "Logical managed-service request path only, not a host path or dispatch route. Semantic validator enforces clean form and permitted selector scope.",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\\\x00-\\x1f\\x7f][^\\\\\\x00-\\x1f\\x7f]*$",
      "description": "Within one declared file namespace. Reject dot segments, empty segments and noncanonical paths in code.",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "contains": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "predicates": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    },
    "json0": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 1024
        }
      ]
    },
    "json1": {
      "oneOf": [
        {
          "$ref": "#/$defs/json0"
        },
        {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/json0"
          }
        },
        {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/json0"
          }
        }
      ]
    },
    "json2": {
      "oneOf": [
        {
          "$ref": "#/$defs/json0"
        },
        {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/json1"
          }
        },
        {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/json1"
          }
        }
      ]
    },
    "json3": {
      "oneOf": [
        {
          "$ref": "#/$defs/json0"
        },
        {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/json2"
          }
        },
        {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/json2"
          }
        }
      ]
    },
    "modelSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "call_ordinal"
      ],
      "properties": {
        "tool_name": {
          "$ref": "#/$defs/shortText"
        },
        "call_ordinal": {
          "$ref": "#/$defs/ordinal"
        },
        "arguments_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "arguments_equal": {
          "$ref": "#/$defs/json3"
        },
        "arguments_contain": {
          "$ref": "#/$defs/contains"
        },
        "turn_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "mcpSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "tool_name",
        "call_ordinal"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/id"
        },
        "tool_name": {
          "$ref": "#/$defs/shortText"
        },
        "call_ordinal": {
          "$ref": "#/$defs/ordinal"
        },
        "arguments_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "arguments_equal": {
          "$ref": "#/$defs/json3"
        },
        "arguments_contain": {
          "$ref": "#/$defs/contains"
        }
      }
    },
    "httpSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "call_ordinal"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/id"
        },
        "call_ordinal": {
          "$ref": "#/$defs/ordinal"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Z]+$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "path": {
          "$ref": "#/$defs/logicalPath"
        },
        "query_equal": {
          "$ref": "#/$defs/predicates"
        },
        "headers_equal": {
          "$ref": "#/$defs/predicates",
          "description": "Case-insensitive security/routing-header denylist and duplicate normalization checked in code."
        },
        "request_body_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "request_body_equal": {
          "$ref": "#/$defs/json3"
        },
        "request_body_contain": {
          "$ref": "#/$defs/contains"
        }
      }
    },
    "stateSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "collection",
            "key"
          ],
          "properties": {
            "service": {
              "$ref": "#/$defs/id"
            },
            "collection": {
              "$ref": "#/$defs/shortText"
            },
            "key": {
              "$ref": "#/$defs/shortText"
            },
            "turn_id": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file_namespace",
            "relative_path"
          ],
          "properties": {
            "file_namespace": {
              "$ref": "#/$defs/id"
            },
            "relative_path": {
              "$ref": "#/$defs/relativePath"
            },
            "turn_id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "placement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "pointer"
          ],
          "properties": {
            "operation": {
              "enum": [
                "replace",
                "prepend_text",
                "append_text"
              ]
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "pointer",
            "index"
          ],
          "properties": {
            "operation": {
              "const": "insert_array"
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "pointer",
            "allowed_fields"
          ],
          "properties": {
            "operation": {
              "const": "merge_object"
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "allowed_fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/shortText"
              }
            }
          }
        }
      ]
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "mode",
        "scope",
        "selector",
        "placement"
      ],
      "properties": {
        "surface": {
          "enum": [
            "model_tool_result",
            "service_response",
            "mcp_tool_result",
            "environment_state",
            "database_response"
          ]
        },
        "mode": {
          "enum": [
            "simulation",
            "fidelity"
          ]
        },
        "scope": {
          "enum": [
            "once",
            "next_turn",
            "standing"
          ]
        },
        "selector": {
          "anyOf": [
            {
              "$ref": "#/$defs/modelSelector"
            },
            {
              "$ref": "#/$defs/mcpSelector"
            },
            {
              "$ref": "#/$defs/httpSelector"
            },
            {
              "$ref": "#/$defs/stateSelector"
            },
            {
              "$ref": "#/$defs/databaseSelector"
            }
          ]
        },
        "placement": {
          "$ref": "#/$defs/placement"
        }
      },
      "oneOf": [
        {
          "properties": {
            "surface": {
              "const": "model_tool_result"
            },
            "mode": {
              "const": "simulation"
            },
            "selector": {
              "$ref": "#/$defs/modelSelector"
            }
          }
        },
        {
          "properties": {
            "surface": {
              "const": "service_response"
            },
            "mode": {
              "const": "simulation"
            },
            "scope": {
              "enum": [
                "once",
                "standing"
              ]
            },
            "selector": {
              "$ref": "#/$defs/httpSelector"
            },
            "placement": {
              "properties": {
                "operation": {
                  "enum": [
                    "replace",
                    "prepend_text",
                    "append_text",
                    "merge_object"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "surface": {
              "const": "mcp_tool_result"
            },
            "mode": {
              "const": "simulation"
            },
            "scope": {
              "enum": [
                "once",
                "standing"
              ]
            },
            "selector": {
              "$ref": "#/$defs/mcpSelector"
            },
            "placement": {
              "properties": {
                "operation": {
                  "enum": [
                    "replace",
                    "prepend_text",
                    "append_text",
                    "merge_object"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "surface": {
              "const": "environment_state"
            },
            "mode": {
              "const": "fidelity"
            },
            "selector": {
              "$ref": "#/$defs/stateSelector"
            }
          }
        },
        {
          "properties": {
            "surface": {
              "const": "database_response"
            },
            "mode": {
              "const": "simulation"
            },
            "scope": {
              "enum": [
                "once",
                "standing"
              ]
            },
            "selector": {
              "$ref": "#/$defs/databaseSelector"
            }
          }
        }
      ]
    },
    "databaseSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "call_ordinal"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/id"
        },
        "call_ordinal": {
          "$ref": "#/$defs/ordinal"
        },
        "request_body_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "request_body_equal": {
          "$ref": "#/$defs/json3"
        },
        "request_body_contain": {
          "$ref": "#/$defs/contains"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "pre_actions"
        ],
        "properties": {
          "pre_actions": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "injection_input"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "injection_input"
              ]
            },
            {
              "required": [
                "retain_injections"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "scenario"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "scenario_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "scenario_id"
          ]
        }
      }
    }
  ],
  "description": "Ordinary target invocation. Host assigns attempt identity, index and lineage. Omitted pre_actions means none; omitted observation_selection means all-permitted. Runtime validates references, direct byte/depth limits and target capabilities before dispatch."
}
