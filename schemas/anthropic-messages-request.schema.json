{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:anthropic-messages-request:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "system": {
      "type": "string",
      "minLength": 0,
      "maxLength": 131072
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/message"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stream": {
      "const": false
    },
    "thinking": {
      "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/thinking"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:anthropic-messages-common:v1alpha1#/$defs/tool"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "tool_choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "auto",
            "any",
            "none"
          ]
        }
      },
      "required": [
        "type"
      ]
    }
  },
  "required": [
    "model",
    "system",
    "messages",
    "max_tokens",
    "stream",
    "thinking",
    "tools",
    "tool_choice"
  ]
}
