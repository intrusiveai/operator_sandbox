{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:openai-chat-response:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "object": {
      "const": "chat.completion"
    },
    "created": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/model"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "const": 0
          },
          "message": {
            "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/response_assistant"
          },
          "finish_reason": {
            "enum": [
              "stop",
              "tool_calls",
              "length",
              "content_filter"
            ]
          },
          "logprobs": {
            "type": "null"
          },
          "content_filter_results": {
            "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/azure_filter_results"
          }
        },
        "required": [
          "index",
          "message",
          "finish_reason"
        ]
      },
      "minItems": 1,
      "maxItems": 1
    },
    "prompt_filter_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "content_filter_results": {
            "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/azure_filter_results"
          }
        },
        "required": [
          "prompt_index",
          "content_filter_results"
        ]
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serving_pipereplica": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "serving_pipereplica"
      ]
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "service_tier": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "default",
            "flex",
            "scale",
            "priority"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "object",
    "created",
    "model",
    "choices"
  ]
}
