{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:operation-registry:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "operator.dev/operation-registry/v1alpha1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "engine.artifact_begin",
              "engine.artifact_commit",
              "engine.artifact_put_part",
              "engine.attempt_execute",
              "engine.injection_delete",
              "engine.model_generate",
              "engine.observation_read",
              "engine.record_append",
              "engine.request_stop",
              "engine.restore_request",
              "engine.snapshot_inspect",
              "engine.snapshot_list",
              "engine.snapshot_request"
            ]
          },
          "request_schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "result_schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "error_schema": {
            "const": "urn:operator:schema:operation-error:v1alpha1"
          },
          "error_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 29,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ACTION_UNAVAILABLE",
                "ARTIFACT_BUDGET_EXCEEDED",
                "ARTIFACT_INTEGRITY_FAILED",
                "CLEANUP_FAILED",
                "CONCLUSION_INVALID",
                "DEADLINE_EXCEEDED",
                "FEEDBACK_BUDGET_EXCEEDED",
                "IDEMPOTENCY_CONFLICT",
                "INTERNAL_ERROR",
                "INVALID_ARGUMENTS",
                "INVALID_OBSERVATION_READ",
                "LIMIT_EXCEEDED",
                "OBSERVATION_INTEGRITY_FAILED",
                "OBSERVATION_NOT_FOUND",
                "OBSERVATION_NOT_PERMITTED",
                "OBSERVATION_RANGE_INVALID",
                "OUTCOME_UNKNOWN",
                "POLICY_DENIED",
                "RECORD_REFERENCE_INVALID",
                "RESTORE_FAILED",
                "SNAPSHOT_BUDGET_EXCEEDED",
                "SNAPSHOT_FAILED",
                "SNAPSHOT_INCOMPATIBLE",
                "SNAPSHOT_NOT_FOUND",
                "STATE_CHANGED",
                "UNSUPPORTED_CAPABILITY",
                "UPLOAD_INCOMPLETE",
                "UPLOAD_NOT_FOUND",
                "UPLOAD_RANGE_INVALID"
              ]
            }
          },
          "lifecycle_states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "admitted",
                "finalizing"
              ]
            }
          },
          "finalization_rule": {
            "enum": [
              "denied",
              "conclusion-only",
              "stop"
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          },
          "max_request_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "max_result_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "effect": {
            "enum": [
              "read",
              "artifact-write",
              "target-write",
              "stop",
              "record-write",
              "model-call"
            ]
          },
          "receipt_policy": {
            "enum": [
              "none",
              "durable"
            ]
          }
        },
        "required": [
          "name",
          "request_schema",
          "result_schema",
          "error_schema",
          "error_codes",
          "lifecycle_states",
          "finalization_rule",
          "timeout_ms",
          "max_request_bytes",
          "max_result_bytes",
          "effect",
          "receipt_policy"
        ]
      }
    }
  },
  "required": [
    "api_version",
    "operations"
  ]
}
