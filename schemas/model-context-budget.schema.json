{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:model-context-budget:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requested_completion_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reserved_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_prompt_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_model_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_model_turns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "near_prompt_limit": {
      "type": "boolean"
    }
  },
  "required": [
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "requested_completion_tokens",
    "reserved_tokens",
    "remaining_prompt_tokens",
    "remaining_model_tokens",
    "remaining_model_turns",
    "near_prompt_limit"
  ]
}
