{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:assessment:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "description": "Assessment completeness, separate from whether objectives succeeded."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "Concise assessment based on the available evidence."
    },
    "objectives": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/objective"
      },
      "description": "Outcomes for submitted objectives."
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/hypothesis"
      },
      "description": "Optional local hypothesis definitions and outcomes."
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/claim"
      },
      "description": "Claims interpreted from retained evidence."
    },
    "coverage": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/coverage_entry"
      },
      "description": "Coverage of submitted objectives, separate from proof of success."
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/uncertainty"
      },
      "description": "Limitations of the available evidence."
    },
    "record_refs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
      },
      "uniqueItems": true,
      "description": "Accepted historical record receipts supporting this assessment."
    }
  },
  "required": [
    "summary",
    "objectives"
  ],
  "$defs": {
    "byte_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/integer",
          "description": "Zero-based byte offset at which to start reading."
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "offset",
        "length"
      ]
    },
    "observation_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_receipt_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        },
        "entry_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        },
        "range": {
          "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/byte_range"
        }
      },
      "required": [
        "attempt_receipt_id",
        "entry_id"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "scenario",
            "exploratory"
          ]
        },
        "scenario_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id",
          "description": "Submitted scenario associated with scenario-origin work."
        },
        "parent_hypothesis_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        }
      },
      "required": [
        "origin"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "scenario"
              }
            }
          },
          "then": {
            "required": [
              "scenario_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "scenario_id"
              ]
            }
          }
        }
      ]
    },
    "coverage_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id",
          "description": "Identifier of the submitted objective being assessed."
        },
        "hypothesis_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        },
        "alternative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Alternative experiment or approach considered."
        },
        "status": {
          "enum": [
            "tested",
            "untested",
            "partial"
          ],
          "description": "Assessment completeness, separate from whether objectives succeeded."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Explanation of the coverage status."
        },
        "attempt_receipt_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "objective_id",
        "status",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "tested",
                "description": "Assessment completeness, separate from whether objectives succeeded."
              }
            }
          },
          "then": {
            "properties": {
              "attempt_receipt_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "The claim or hypothesis being assessed."
        },
        "interpretation": {
          "enum": [
            "supported",
            "inconclusive",
            "not-observed"
          ],
          "description": "Whether the evidence supports the claim, is inconclusive, or contradicts it."
        },
        "assurance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The basis for the assessment assurance."
        },
        "attempt_receipt_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        },
        "observation_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/observation_ref"
          }
        },
        "uncertainty_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Confidence in the assessment: low, medium, or high."
        }
      },
      "required": [
        "claim_id",
        "statement",
        "interpretation",
        "assurance",
        "confidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "interpretation": {
                "const": "supported",
                "description": "Whether the evidence supports the claim, is inconclusive, or contradicts it."
              }
            }
          },
          "then": {
            "properties": {
              "observation_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id",
          "description": "Identifier of the submitted objective being assessed."
        },
        "outcome": {
          "enum": [
            "supported",
            "inconclusive",
            "not-observed",
            "not-tested"
          ],
          "description": "Whether evidence supports this objective or hypothesis, is inconclusive, or it was not tested."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Concise assessment based on the available evidence."
        },
        "attempt_receipt_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        },
        "record_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "objective_id",
        "outcome",
        "summary"
      ]
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypothesis_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        },
        "objective_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true,
          "description": "Submitted objective identifiers associated with this hypothesis or record."
        },
        "provenance": {
          "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/provenance"
        },
        "outcome": {
          "enum": [
            "supported",
            "inconclusive",
            "not-observed",
            "not-tested"
          ],
          "description": "Whether evidence supports this objective or hypothesis, is inconclusive, or it was not tested."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Concise assessment based on the available evidence."
        },
        "attempt_receipt_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        },
        "record_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "hypothesis_id",
        "provenance",
        "outcome",
        "summary"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
        },
        "kind": {
          "enum": [
            "unresolved-effects",
            "unavailable-feedback",
            "truncated-feedback",
            "unread-input",
            "summarized-input",
            "omitted-range",
            "coverage-limit",
            "evidence-gap"
          ],
          "description": "The kind of record or uncertainty represented by this object."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Explanation of this uncertainty or retained item."
        },
        "observation_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/observation_ref"
          }
        },
        "input_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entry_id": {
                "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
              },
              "range": {
                "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/byte_range"
              }
            },
            "required": [
              "entry_id"
            ]
          }
        },
        "record_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "gap_id",
        "kind",
        "description"
      ]
    },
    "record_kind": {
      "enum": [
        "hypothesis",
        "progress",
        "lineage",
        "coverage",
        "conclusion"
      ]
    }
  },
  "description": "Assessment draft: summary and explicit objective outcomes are required. Omitted status resolves to partial; omitted collections to empty arrays. No claims, outcomes, evidence or hypotheses are inferred. Supported outcomes require execution evidence."
}
