{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:openai-responses-request:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 0,
      "maxLength": 131072
    },
    "input": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/user"
          },
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/message"
          },
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/reasoning_item"
          },
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/call"
          },
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/result"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stream": {
      "const": false
    },
    "store": {
      "const": false
    },
    "parallel_tool_calls": {
      "const": true
    },
    "include": {
      "type": "array",
      "items": {
        "const": "reasoning.encrypted_content"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "truncation": {
      "const": "disabled"
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/reasoning"
        },
        {
          "type": "null"
        }
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/tool"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "tool_choice": {
      "enum": [
        "auto",
        "none",
        "required"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            }
          },
          "required": [
            "type"
          ]
        }
      },
      "required": [
        "format"
      ]
    }
  },
  "required": [
    "model",
    "instructions",
    "input",
    "max_output_tokens",
    "stream",
    "store",
    "parallel_tool_calls",
    "include",
    "truncation",
    "reasoning",
    "tools",
    "tool_choice",
    "text"
  ]
}
