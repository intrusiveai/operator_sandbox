{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:engine-model-generate-request:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "enum": [
        "generation",
        "compaction"
      ]
    },
    "conversation": {
      "type": "array",
      "description": "Opaque provider-native conversation history. Operator supplies all request configuration; entries are never merged into top-level options."
    }
  },
  "required": [
    "purpose",
    "conversation"
  ]
}
