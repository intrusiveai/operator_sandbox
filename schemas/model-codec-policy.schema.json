{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:model-codec-policy:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "codec_id": {
      "const": "openai-chat-text-tools-v1"
    },
    "profile_id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "profile_digest": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/digest"
    },
    "request_model": {
      "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/model"
    },
    "response_models": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/model"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "instruction_role": {
      "enum": [
        "system",
        "developer"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 0,
      "maxLength": 131072
    },
    "max_completion_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/tool"
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "codec_id",
    "profile_id",
    "profile_digest",
    "request_model",
    "response_models",
    "instruction_role",
    "prompt",
    "max_completion_tokens",
    "tools"
  ]
}
