{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:engine-diagnostic-report-request:v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "tool_call_id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "diagnostic": {
      "allOf": [
        {
          "$ref": "urn:operator:schema:workflow-diagnostic:v1alpha1"
        },
        {
          "properties": {
            "source": {
              "const": "harness-local"
            }
          }
        }
      ]
    },
    "stopping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "condition": {
          "enum": [
            "invalid-call-limit",
            "tool-call-limit",
            "model-turn-limit",
            "wall-time-limit",
            "context-limit",
            "budget-limit",
            "local-error"
          ]
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "configured_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "model-tokens"
            },
            "total_allowance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "consumed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "remaining": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "next_request_reservation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "total_allowance",
            "consumed",
            "remaining",
            "next_request_reservation"
          ]
        }
      },
      "required": [
        "condition"
      ],
      "oneOf": [
        {
          "required": [
            "budget"
          ],
          "properties": {
            "condition": {
              "const": "budget-limit"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "observed_count"
                ]
              },
              {
                "required": [
                  "configured_limit"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "observed_count",
            "configured_limit"
          ],
          "not": {
            "required": [
              "budget"
            ]
          }
        }
      ]
    },
    "observation_selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_path",
          "observation_ref"
        ],
        "properties": {
          "field_path": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^/(objectives|hypotheses|coverage|entries)/[0-9]{1,3}/observations/[0-9]{1,2}$"
          },
          "observation_ref": {
            "$ref": "urn:operator:schema:assessment:v1alpha1#/$defs/observation_ref"
          }
        }
      }
    }
  },
  "required": [
    "diagnostic"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "observation_selections"
        ]
      },
      "then": {
        "properties": {
          "diagnostic": {
            "properties": {
              "reason": {
                "const": "observation_selection"
              },
              "stage": {
                "const": "references"
              }
            }
          }
        },
        "not": {
          "required": [
            "stopping"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "stopping"
        ],
        "properties": {
          "stopping": {
            "required": [
              "budget"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "diagnostic": {
            "properties": {
              "reason": {
                "const": "model_reservation_unavailable"
              },
              "stage": {
                "const": "termination"
              },
              "resubmission_safe": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "field_path"
                  ]
                },
                {
                  "required": [
                    "identifier"
                  ]
                },
                {
                  "required": [
                    "correction"
                  ]
                }
              ]
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "tool_name"
              ]
            },
            {
              "required": [
                "tool_call_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "diagnostic": {
            "properties": {
              "reason": {
                "const": "model_reservation_unavailable"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "stopping"
        ],
        "properties": {
          "stopping": {
            "required": [
              "budget"
            ]
          }
        }
      }
    }
  ]
}
