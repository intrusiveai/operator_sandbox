{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:gemini-response:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/assistant"
          },
          "finishReason": {
            "enum": [
              "STOP",
              "MAX_TOKENS",
              "SAFETY",
              "RECITATION",
              "LANGUAGE",
              "OTHER",
              "BLOCKLIST",
              "PROHIBITED_CONTENT",
              "SPII",
              "MALFORMED_FUNCTION_CALL",
              "IMAGE_SAFETY",
              "IMAGE_PROHIBITED_CONTENT",
              "IMAGE_OTHER",
              "NO_IMAGE",
              "IMAGE_RECITATION",
              "UNEXPECTED_TOOL_CALL",
              "TOO_MANY_TOOL_CALLS",
              "MISSING_THOUGHT_SIGNATURE",
              "MALFORMED_RESPONSE",
              "ESCALATION",
              "PUP_LIMITED_DISABLED"
            ]
          },
          "index": {
            "const": 0
          },
          "finishMessage": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1048576
          },
          "safetyRatings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "category": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "probability": {
                  "enum": [
                    "HARM_PROBABILITY_UNSPECIFIED",
                    "NEGLIGIBLE",
                    "LOW",
                    "MEDIUM",
                    "HIGH"
                  ]
                },
                "blocked": {
                  "type": "boolean"
                },
                "probabilityScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "severity": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 128
                },
                "severityScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "category",
                "probability"
              ]
            },
            "minItems": 0,
            "maxItems": 32
          },
          "tokenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "avgLogprobs": {
            "type": "number"
          },
          "citationMetadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "citationSources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "startIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endIndex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "uri": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 8192
                    },
                    "license": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 8192
                    }
                  },
                  "required": []
                },
                "minItems": 0,
                "maxItems": 128
              }
            },
            "required": []
          }
        },
        "required": [
          "finishReason"
        ]
      },
      "minItems": 0,
      "maxItems": 1
    },
    "promptFeedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockReason": {
          "enum": [
            "BLOCK_REASON_UNSPECIFIED",
            "SAFETY",
            "OTHER",
            "BLOCKLIST",
            "PROHIBITED_CONTENT",
            "IMAGE_SAFETY"
          ]
        },
        "blockReasonMessage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        },
        "safetyRatings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "probability": {
                "enum": [
                  "HARM_PROBABILITY_UNSPECIFIED",
                  "NEGLIGIBLE",
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "blocked": {
                "type": "boolean"
              },
              "probabilityScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "severity": {
                "type": "string",
                "minLength": 0,
                "maxLength": 128
              },
              "severityScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "category",
              "probability"
            ]
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": []
    },
    "usageMetadata": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:gemini-common:v1alpha1#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "responseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "createTime": {
      "type": "string",
      "minLength": 0,
      "maxLength": 128
    },
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelStage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "retirementTime": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576
        }
      },
      "required": []
    }
  },
  "required": []
}
