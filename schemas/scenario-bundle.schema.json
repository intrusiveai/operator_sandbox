{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:scenario-bundle:v1alpha1",
  "title": "scenario-bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "operator.dev/scenario-bundle/v1alpha1"
    },
    "bundle_id": {
      "$ref": "#/$defs/id"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "kind"
      ]
    },
    "target_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "capability_source_digest": {
          "$ref": "#/$defs/digest"
        },
        "capability_projection_digest": {
          "$ref": "#/$defs/digest"
        },
        "required_capability_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRef"
          },
          "maxItems": 256,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "target_id",
        "capability_source_digest"
      ]
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objective_id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "required": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "required_capability_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/capabilityRef"
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "objective_id",
          "description",
          "required"
        ]
      },
      "maxItems": 100,
      "minItems": 1,
      "uniqueItems": true
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenario_id": {
            "$ref": "#/$defs/id"
          },
          "objective_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 256,
            "minItems": 1,
            "uniqueItems": true
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "required": {
            "type": "boolean"
          },
          "required_capability_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/capabilityRef"
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "guidance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "surfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096
                },
                "maxItems": 256,
                "minItems": 0,
                "uniqueItems": true
              },
              "action_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^action:[A-Za-z0-9][A-Za-z0-9._:-]*$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                },
                "maxItems": 256,
                "minItems": 0,
                "uniqueItems": true
              },
              "mutation_dimensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096
                },
                "maxItems": 256,
                "minItems": 0,
                "uniqueItems": true
              },
              "composition": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096
                },
                "maxItems": 256,
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "surfaces",
              "action_refs",
              "mutation_dimensions",
              "composition"
            ]
          },
          "expected_observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "coverage_obligations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "stopping_guidance": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 256,
            "minItems": 0,
            "uniqueItems": true
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          }
        },
        "required": [
          "scenario_id",
          "objective_refs",
          "hypothesis",
          "priority",
          "required",
          "required_capability_refs",
          "guidance",
          "expected_observations",
          "evidence_criteria",
          "coverage_obligations",
          "stopping_guidance"
        ]
      },
      "maxItems": 256,
      "minItems": 0,
      "uniqueItems": true
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_profile": {
          "enum": [
            "black-box",
            "diagnostic",
            "oracle-assisted"
          ]
        }
      },
      "required": [
        "requested_profile"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "maxItems": 256,
          "minItems": 0,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          "maxItems": 256,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "requested_classes",
        "limitations"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/id"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "visibility": {
            "const": "operator-engine"
          },
          "required": {
            "type": "boolean"
          },
          "schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "omission_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "artifact_id",
          "digest",
          "size_bytes",
          "media_type",
          "purpose",
          "visibility",
          "required"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "required": {
                  "const": true
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "omission_reason"
                ]
              }
            }
          }
        ]
      },
      "maxItems": 4000,
      "minItems": 0,
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 100,
          "minItems": 1,
          "uniqueItems": true
        },
        "completion_guidance": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        }
      },
      "required": [
        "objective_refs",
        "completion_guidance"
      ]
    },
    "context": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "requested_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_admissions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "active_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "model_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_creations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_committed_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_model_turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 300 before effective-limit publication."
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 2000 before effective-limit publication."
            },
            "max_tool_calls_per_response": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 16 before effective-limit publication."
            },
            "max_invalid_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 50 before effective-limit publication."
            },
            "max_consecutive_invalid_tool_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 5 before effective-limit publication."
            },
            "max_read_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 268435456 before effective-limit publication."
            },
            "max_no_progress_turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Administrator omission selects 10 before effective-limit publication."
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "producer",
    "target_requirements",
    "objectives",
    "scenarios",
    "feedback",
    "evidence",
    "artifacts",
    "coverage"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "capabilityRef": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(operation|action|service|file_namespace|evidence|feature):[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          }
        },
        "required": [
          "namespace",
          "key",
          "value"
        ]
      },
      "maxItems": 128,
      "minItems": 0,
      "uniqueItems": true
    }
  }
}
