{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:openai-responses-response:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "urn:operator:schema:wire-common:v1alpha1#/$defs/id"
    },
    "object": {
      "const": "response"
    },
    "created_at": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x20\\x7f]+$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "failed",
        "cancelled"
      ]
    },
    "output": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/message"
          },
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/reasoning_item"
          },
          {
            "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/call"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1048576
            }
          },
          "required": [
            "code",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "incomplete_details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "anyOf": [
                {
                  "enum": [
                    "max_output_tokens",
                    "max_messages",
                    "content_filter",
                    "steered"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": []
        },
        {
          "type": "null"
        }
      ]
    },
    "instructions": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 131072
        },
        {
          "type": "null"
        }
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/tool"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "tool_choice": {
      "enum": [
        "auto",
        "none",
        "required"
      ]
    },
    "parallel_tool_calls": {
      "const": true
    },
    "max_output_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "store": {
      "const": false
    },
    "background": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_response_id": {
      "type": "null"
    },
    "conversation": {
      "type": "null"
    },
    "prompt": {
      "type": "null"
    },
    "max_tool_calls": {
      "type": "null"
    },
    "moderation": {
      "type": "null"
    },
    "metadata": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/reasoning"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "anyOf": [
        {
          "$ref": "urn:operator:schema:openai-responses-common:v1alpha1#/$defs/text_config"
        },
        {
          "type": "null"
        }
      ]
    },
    "truncation": {
      "anyOf": [
        {
          "const": "disabled"
        },
        {
          "type": "null"
        }
      ]
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "top_p": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "top_logprobs": {
      "anyOf": [
        {
          "const": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "service_tier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "user": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "safety_identifier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_cache_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_cache_retention": {
      "anyOf": [
        {
          "enum": [
            "in_memory",
            "24h"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_cache_options": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "implicit"
            },
            "ttl": {
              "const": "30m"
            },
            "comparison_response_id": {
              "type": "null"
            }
          },
          "required": [
            "mode",
            "ttl"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_cache_diagnostics": {
      "type": "null"
    },
    "access_programs": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cyber": {
              "enum": [
                "standard",
                "daybreak_blue",
                "daybreak_red"
              ]
            }
          },
          "required": [
            "cyber"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "object",
    "created_at",
    "model",
    "status",
    "output"
  ]
}
