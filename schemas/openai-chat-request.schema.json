{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operator:schema:openai-chat-request:v1alpha1",
  "$comment": "Generated by scripts/generate_model_schemas.py; see MODEL_CODEC_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/model"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/message"
      },
      "minItems": 2,
      "maxItems": 4096
    },
    "max_completion_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stream": {
      "const": false
    },
    "store": {
      "const": false
    },
    "n": {
      "const": 1
    },
    "parallel_tool_calls": {
      "const": true
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "urn:operator:schema:openai-chat-common:v1alpha1#/$defs/tool"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "tool_choice": {
      "enum": [
        "auto",
        "none",
        "required"
      ]
    }
  },
  "required": [
    "model",
    "messages",
    "max_completion_tokens",
    "stream",
    "store",
    "n",
    "parallel_tool_calls",
    "tools",
    "tool_choice"
  ]
}
