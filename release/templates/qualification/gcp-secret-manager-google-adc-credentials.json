{
  "profiles": [
    {
      "api_version": "operator.dev/secret-store-profile/v1alpha1",
      "kind": "SecretStoreProfile",
      "id": "qualification-store",
      "backend_kind": "gcp-secret-manager",
      "allowed_locator_prefixes": [
        "gcp://projects/REPLACE/secrets/operator-qualification"
      ],
      "timeout_seconds": 10,
      "authentication": "google-adc"
    }
  ],
  "credentials": [
    {
      "api_version": "operator.dev/host-credential-ref/v1alpha1",
      "kind": "HostCredentialRef",
      "credential_id": "qualification-secret",
      "store_profile_id": "qualification-store",
      "locator": {
        "backend_kind": "gcp-secret-manager",
        "project": "REPLACE",
        "secret_name": "operator-qualification",
        "version": "latest"
      },
      "value": {
        "format": "json-string-field",
        "field": "value"
      },
      "cache_ttl_seconds": 5
    },
    {
      "api_version": "operator.dev/host-credential-ref/v1alpha1",
      "kind": "HostCredentialRef",
      "credential_id": "qualification-missing",
      "store_profile_id": "qualification-store",
      "locator": {
        "backend_kind": "gcp-secret-manager",
        "project": "REPLACE",
        "secret_name": "operator-qualification-missing",
        "version": "latest"
      },
      "value": {
        "format": "json-string-field",
        "field": "value"
      },
      "cache_ttl_seconds": 5
    }
  ]
}
