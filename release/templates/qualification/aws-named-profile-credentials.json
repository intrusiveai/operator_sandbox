{
  "profiles": [
    {
      "api_version": "operator.dev/secret-store-profile/v1alpha1",
      "kind": "SecretStoreProfile",
      "id": "qualification-store",
      "backend_kind": "aws-secrets-manager",
      "allowed_locator_prefixes": [
        "aws://us-east-1/operator-qualification"
      ],
      "timeout_seconds": 10,
      "region": "us-east-1",
      "aws_profile": "REPLACE-profile"
    }
  ],
  "credentials": [
    {
      "api_version": "operator.dev/host-credential-ref/v1alpha1",
      "kind": "HostCredentialRef",
      "credential_id": "qualification-secret",
      "store_profile_id": "qualification-store",
      "locator": {
        "backend_kind": "aws-secrets-manager",
        "region": "us-east-1",
        "secret_id": "operator-qualification",
        "version_stage": "AWSCURRENT"
      },
      "value": {
        "format": "json-string-field",
        "field": "value"
      },
      "cache_ttl_seconds": 5
    },
    {
      "api_version": "operator.dev/host-credential-ref/v1alpha1",
      "kind": "HostCredentialRef",
      "credential_id": "qualification-missing",
      "store_profile_id": "qualification-store",
      "locator": {
        "backend_kind": "aws-secrets-manager",
        "region": "us-east-1",
        "secret_id": "operator-qualification-missing",
        "version_stage": "AWSCURRENT"
      },
      "value": {
        "format": "json-string-field",
        "field": "value"
      },
      "cache_ttl_seconds": 5
    }
  ]
}
